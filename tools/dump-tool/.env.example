# =============================================================================
# Credenciales y configuración de entorno — dump-tool
#
# Copiar este archivo como .env y completar los valores:
#   cp .env.example .env
#
# .env está en .gitignore y NUNCA debe commitearse.
# =============================================================================

# Base de datos remota (RDS)
DB_NAME="db"
DB_USER=""
DB_PASSWORD=""
DB_PORT=5432
DB_HOST=""
DB_SCHEMA="schema"

# Túnel SSH (bastion EC2)
LOCAL_PORT=3001
SSH_USER=""
SSH_HOST=""
SSH_PRIVATE_KEY_PATH="putty_rsa_openssh"   # relativo a $HOME

# Base de datos local
LOCAL_DB_NAME="db_local"
LOCAL_DB_USER="postgres"
LOCAL_DB_PASSWORD=""
LOCAL_DB_HOST="localhost"
LOCAL_DB_PORT=5432

# Brand a exportar (entero — ver tabla de brands en la DB)
BRAND=0

# Binarios de PostgreSQL (opcional — completar si hay múltiples versiones instaladas)
# PSQL_BIN="/usr/lib/postgresql/17/bin/psql"
# PG_DUMP_BIN="/usr/lib/postgresql/17/bin/pg_dump"
# PG_ISREADY_BIN="/usr/lib/postgresql/17/bin/pg_isready"
